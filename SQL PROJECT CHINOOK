-- Q5) Compare each customer against the global average with two CTEs
-- The result shows 16 customers from 59

WITH customer_value_base  AS(  -- previous CTE table for customer
        SELECT  c1.CustomerId,
                c1.FirstName || ' ' || c1.LastName AS Customer_Name,
                c1.Country,
                COUNT(DISTINCT i.InvoiceId) AS Quantity_Invoices,
                COUNT(DISTINCT g.GenreId) AS num_genres,
                ROUND(SUM(ii.UnitPrice * ii.Quantity), 2) AS total_spent,
                COUNT(ii.TrackId) AS total_tracks
        FROM invoices i 
        JOIN customers c1 USING (CustomerId)
        JOIN invoice_items ii USING (InvoiceId)
        JOIN tracks t USING (TrackId)
        JOIN genres g USING (GenreId)
        GROUP BY c1.customerId
        ),
     
    global_avg AS (
        SELECT  AVG(total_spent) AS avg_spent,
                AVG(Quantity_Invoices) AS avg_invoices,
                AVG(num_genres) AS avg_genres
        FROM customer_value_base
)

SELECT c.CustomerId,
       c.customer_Name,
       c.Country
FROM customer_value_base c CROSS JOIN global_avg g
WHERE   c.total_spent > g.avg_spent
AND     c.Quantity_Invoices > g.avg_invoices
AND     c.num_genres > g.avg_genres
GROUP BY CustomerId, Country;

