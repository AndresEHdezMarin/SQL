-- Q1) How is the customers global average behaving in spending, number of invoices, and gender diversity — all calculated in a single pass?

WITH customer_genres AS (
    SELECT
        c.CustomerId,
        COUNT(DISTINCT g.GenreId) AS num_genres
    FROM customers c
    JOIN invoices i USING (CustomerId)
    JOIN invoice_items ii USING (InvoiceId)
    JOIN tracks t USING (TrackId)
    JOIN genres g USING (GenreId)
    GROUP BY c.CustomerId
)

, customer_spend AS (
    SELECT
        c.CustomerId,
        c.FirstName || ' ' || c.LastName AS Customer_Name,
        c.Country,

        COUNT(i.InvoiceId) OVER (PARTITION BY c.CustomerId) AS qty_invoices,
        SUM(ii.UnitPrice * ii.Quantity) OVER (PARTITION BY c.CustomerId) AS total_spent
    FROM customers c
    JOIN invoices i USING (CustomerId)
    JOIN invoice_items ii USING (InvoiceId)
)

SELECT DISTINCT
    cs.CustomerId,
    cs.Customer_Name,
    cs.Country,
    cs.qty_invoices,
    ROUND(cs.total_spent, 2) AS total_spent,
    cg.num_genres
FROM customer_spend cs
JOIN customer_genres cg
    ON cs.CustomerId = cg.CustomerId;

-- Q2) This query can gives DATA that can response to this questions: 
-- What is the total value of each invoice, and how is that value composed at the track, album, artist, and genre level?
-- Within each invoice, which artists, albums, or genres are contributing to higher-value purchases?

SELECT
        c.CustomerId,
        ii.InvoiceId,
        c.FirstName || ' ' || c.LastName AS Customer_Name,
        a.Name AS Artist_Name,
        t.Name AS Track_Name,
        alb.Title AS Album_Title,
        g.Name AS Genre_Name,
        SUM(ii.UnitPrice * ii.Quantity) OVER (PARTITION BY ii.InvoiceId) AS total_invoice
    FROM customers c
    JOIN invoices i USING (CustomerId)
    JOIN invoice_items ii USING (InvoiceId)
    JOIN tracks t USING (TrackId)
    JOIN genres g USING (GenreId)
    JOIN albums alb USING (AlbumId)
    JOIN artists a USING (ArtistId)
ORDER BY c.CustomerId, ii.InvoiceId;


-- Q3) How much does each music genre contribute to Chinook’s total revenue?

SELECT  g.GenreId,
        g.name AS Genre_Name,
        COUNT(g.name) AS Invoice_Purchases,
        SUM(ii.UnitPrice * ii.Quantity) AS Total_per_Genre,
        SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER () AS total_sales_all_genres,
        ROUND(SUM(ii.UnitPrice * ii.Quantity)
            / SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER (),4)*100 AS genre_sales_percent
FROM genres g 
JOIN tracks t USING (GenreId)
JOIN invoice_items ii USING (TrackId)
GROUP BY g.GenreId, g.Name
ORDER BY genre_sales_percent DESC;


-- Q4) Which genres sustain the business in terms of revenue?

SELECT  g.GenreId,
        g.name AS Genre_Name,
        COUNT(g.name) AS Invoice_Purchases,
        SUM(ii.UnitPrice * ii.Quantity) AS Total_per_Genre,
        
        -- total global (repeated in all rows)
        SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER () AS total_sales_all,
        
        -- percentage by gender
        ROUND(SUM(ii.UnitPrice * ii.Quantity)
            / SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER (),4)*100 AS genre_sales_percent,
        
        -- Pareto-type cumulative
        ROUND(
        SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER (
            ORDER BY SUM(ii.UnitPrice * ii.Quantity) DESC
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )
        / SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER ()
    ,3) * 100 AS cumulative_percent
FROM genres g 
JOIN tracks t USING (GenreId)
JOIN invoice_items ii USING (TrackId)
GROUP BY g.GenreId, g.Name
ORDER BY Total_per_Genre DESC ;

-- Q5) How important was each invoice within the client's total spending?

SELECT
        c.CustomerId,
        c.FirstName || ' ' || c.LastName AS Customer_Name,
        ii.InvoiceId,
         
	-- Total histórico del cliente
        
	SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER (PARTITION BY c.CustomerId) AS total_inv_cust,
	
            -- Total por invoice	
	
	SUM(ii.UnitPrice*ii.Quantity) AS Total_per_invoice,
                 
	-- % que representa la invoice dentro del cliente
	
        ROUND(
            SUM(ii.UnitPrice * ii.Quantity)
            / SUM(SUM(ii.UnitPrice * ii.Quantity)) OVER (PARTITION BY c.CustomerId), 4
        )*100 AS inv_sales_percent_from_Cust_Total
    
    FROM customers c
    JOIN invoices i USING (CustomerId)
    JOIN invoice_items ii USING (InvoiceId)
GROUP BY c.CustomerId, ii.InvoiceId
ORDER BY c.CustomerId;


