-- Q1) Which customers have a higher average spend than the average spend of all customers?

SELECT Temp_cust.* 
FROM (    
        SELECT  CustomerID, 
                FirstName || ' ' || LastName AS Customer,
                ROUND(AVG(Total),2) AS Avg_Client_Spend
        FROM customers JOIN invoices USING (CustomerID)
        GROUP BY CustomerID
        ) Temp_cust
WHERE Avg_Client_Spend> (SELECT AVG(Total) FROM invoices)
ORDER BY Client_Spend DESC;

-- Q2) Which customers have a higher average bill spend than the average bill spend of customers in their own country?

SELECT  c.CustomerID, 
        c.FirstName || ' ' || c.LastName AS Customer,
        c.Country,
        ROUND(AVG(i.Total),2) AS Avg_Client_Spend
FROM customers c 
JOIN invoices i USING (CustomerID)
GROUP BY c.CustomerID, c.Country
HAVING AVG(i.Total)> (SELECT AVG(Total) FROM invoices WHERE c.Country=BillingCountry);

-- Q3) Which artists have MORE songs than the average number of songs per artist in the database?


SELECT  a1.Name,
        COUNT(t1.TrackId) AS Quantity_songs
FROM artists a1 JOIN albums
    USING (ArtistId)
JOIN tracks t1
    USING (AlbumId)
GROUP BY a1.ArtistId
HAVING Quantity_songs > (SELECT AVG(songs_per_artist)
                        FROM 
                            (SELECT COUNT(t2.TrackId) AS songs_per_artist 
                            FROM tracks t2 JOIN albums alb
                                ON t2.AlbumId = alb.AlbumId
                            JOIN artists a2
                                ON a2.ArtistId=alb.ArtistId
                            GROUP BY a2.ArtistId
                            )
                        )
ORDER BY Quantity_songs DESC;

-- Q4) Which playlists contain a greater number of different genres than the average number of genres per playlist?

SELECT  pl.Name AS Playlist,
        COUNT(DISTINCT g.Name) AS Num_Genres
FROM    playlists pl 
LEFT JOIN  playlist_track pt USING (PlaylistId)
JOIN tracks t USING (TrackId)
JOIN Genres g USING (GenreId)
GROUP BY PlaylistId
HAVING Num_Genres > (SELECT AVG(Quantity_Genres)
                     FROM(
                        SELECT COUNT(DISTINCT g.Name) AS Quantity_Genres
                        FROM    playlists pl 
                        LEFT JOIN  playlist_track pt USING (PlaylistId)
                        JOIN tracks t USING (TrackId)
                        JOIN Genres g USING (GenreId)
                        GROUP BY PlaylistId
                        )
                    )
ORDER BY Num_Genres DESC;

