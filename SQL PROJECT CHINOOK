-- Q1) Which customers have purchased a greater diversity of genres from Chinook's portfolio compared to the average customer?

WITH genres_per_customer  AS(
        SELECT  c1.CustomerId,
                COUNT(DISTINCT g.Name) AS quantity_genres
            FROM customers c1 
            JOIN invoices i USING (CustomerId)
            JOIN invoice_items ii USING (InvoiceId)
            JOIN tracks t USING (TrackId)
            JOIN genres g USING (GenreId)
        GROUP BY CustomerId
        )

SELECT  c.FirstName || ' ' || c.LastName AS Customer,
        gpc.quantity_genres
FROM customers c 
JOIN genres_per_customer gpc USING (CustomerId)
WHERE gpc.quantity_genres > (SELECT AVG(quantity_genres) FROM genres_per_customer);

-- Q2) Which customers have placed fewer invoices than the average customer?

WITH invoices_per_customer AS (
    SELECT  c1.CustomerId,
            COUNT(i.InvoiceId) AS quantity_invoices
    FROM customers c1 JOIN invoices i USING (CustomerId)
    GROUP BY c1.CustomerId
)

SELECT  c.FirstName || ' ' || c.LastName AS Customer,
        ipc.quantity_invoices
FROM invoices_per_customer ipc JOIN customers c
    USING (CustomerId)
WHERE ipc.quantity_invoices < (SELECT AVG(quantity_invoices) FROM invoices_per_customer);

